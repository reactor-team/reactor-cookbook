# Required. Stays on the server and is exchanged for a session-scoped JWT in app/api/token/route.ts.
REACTOR_API_KEY=rk_your_api_key_here

# Optional. Turns a short "what happens next" beat into full shot direction (app/api/direct/route.ts).
# Without it, the beat you type is sent to the model as written.
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-haiku-5-5

# Live monitoring uses OpenAI Decisions (gpt-6-luna) for image and text checks.
OPENAI_API_KEY=

# Optional. Exact HTTPS origin when opening Previs through a private reverse proxy.
# For Tailscale Serve: https://your-mac.your-tailnet.ts.net
PREVIS_PUBLIC_ORIGIN=
