# The voice agent. Copy to .env and fill in.

# The LiveKit project the rooms are on: the same three values as in ../client/.env.local.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<livekit api key>
LIVEKIT_API_SECRET=<livekit api secret>

# OpenAI Realtime holds the conversation.
OPENAI_API_KEY=<openai api key>

# The name the page's server dispatches this worker by: the same AVATAR_AGENT_NAME as in ../client/.env.local.
AVATAR_AGENT_NAME=avatar-agent-<your name>

# The voice when a dispatch names none.
# AVATAR_AGENT_VOICE=marin
