REACTOR_API_KEY=rk_your_api_key_here

# Powers the one-time composition-pass LLM call (Nemotron via NVIDIA's
# OpenAI-compatible endpoint). Get one at https://build.nvidia.com.
# Composing a song's score fails outright without this — no client-side
# fallback, by design (see the README).
NVIDIA_NEMO_KEY=your_nvidia_nemo_key_here
