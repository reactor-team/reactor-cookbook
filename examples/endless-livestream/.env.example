# Required. rk_... from https://www.reactor.inc/account/api-keys
# The server mints short-lived session tokens from it; the browser never sees it.
REACTOR_API_KEY=

# Optional. Turns on the director, which writes each clip's prompt from the
# steer box and the last few clips (Claude Sonnet 5.5 plans episodes, Claude Haiku 5.5 writes clips; server-side only).
# Without it the steer text is sent to the model as is.
ANTHROPIC_API_KEY=
