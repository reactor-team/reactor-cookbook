# The page's server. Copy to .env.local and fill in; every value stays on the server.

# The LiveKit project the rooms are on: the same three values as in agent/.env. The avatar joins from where the
# model runs, so the URL must be reachable from there (a LiveKit Cloud project is).
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<livekit api key>
LIVEKIT_API_SECRET=<livekit api secret>

# The voice agent to dispatch into each call: the same AVATAR_AGENT_NAME as in agent/.env.
AVATAR_AGENT_NAME=avatar-agent-<your name>

# The avatar model. Either a runtime you serve yourself (reactor run) ...
REACTOR_RUNTIME_URL=http://127.0.0.1:8080
# ... or a model deployed on Reactor (leave REACTOR_RUNTIME_URL unset):
# REACTOR_API_KEY=<rk_ key>
# REACTOR_MODEL=<your model's name>
