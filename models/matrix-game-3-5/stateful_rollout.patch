+class _InteractiveVideoDecoder:
+    """Decode the rollout chunk by chunk exactly as one decode of its history.
+
+    ``run_distilled_inference`` writes ``result.mp4`` from a single VAE decode
+    of ``[C0] + every generated latent``. The Wan2.2 decoder consumes one
+    latent per step with a causal cache, so carrying each spatial tile's cache
+    across chunks yields the same frames without re-decoding the history.
+    """
+
+    def __init__(self, pipe, device, tiled, tile_size=(30, 52), tile_stride=(15, 26)):
+        from diffsynth.models.wan_video_vae import VideoVAE38_, count_conv3d
+
+        if not isinstance(pipe.vae.model, VideoVAE38_):
+            raise RuntimeError("interactive decode requires the Wan2.2 VAE")
+        self._pipe = pipe
+        self._device = device
+        self._tiled = bool(tiled)
+        self._tile_size = tile_size
+        self._tile_stride = tile_stride
+        self._conv_count = count_conv3d(pipe.vae.model.decoder)
+        self._tasks = None
+        self._caches = None
+
+    def decode(self, latents):
+        """Return uint8 frames for new latents; the first call includes C0."""
+        from diffsynth.models.wan_video_vae import unpatchify
+
+        vae = self._pipe.vae
+        model = vae.model
+        if latents.ndim == 4:
+            latents = latents.unsqueeze(0)
+        # Mirror _decode_latents_to_numpy_frames and WanVideoVAE.decode.
+        hidden = latents.to(device=self._device, dtype=self._pipe.torch_dtype).to("cpu")
+        _, _, T, H, W = hidden.shape
+        first = self._tasks is None
+        if first:
+            if self._tiled:
+                size_h, size_w = self._tile_size
+                stride_h, stride_w = self._tile_stride
+                self._tasks = []
+                for h in range(0, H, stride_h):
+                    if h - stride_h >= 0 and h - stride_h + size_h >= H:
+                        continue
+                    for w in range(0, W, stride_w):
+                        if w - stride_w >= 0 and w - stride_w + size_w >= W:
+                            continue
+                        self._tasks.append((h, h + size_h, w, w + size_w))
+            else:
+                self._tasks = [(0, H, 0, W)]
+            self._caches = [[None] * self._conv_count for _ in self._tasks]
+        self._pipe.load_models_to_device(["vae"])
+        factor = vae.upsampling_factor
+        out_t = T * 4 - 3 if first else T * 4
+        values = weight = None
+        if self._tiled:
+            shape = (1, 1, out_t, H * factor, W * factor)
+            weight = torch.zeros(shape, dtype=hidden.dtype, device="cpu")
+            values = torch.zeros((1, 3, *shape[2:]), dtype=hidden.dtype, device="cpu")
+        for index, (h, h_, w, w_) in enumerate(self._tasks):
+            z = hidden[:, :, :, h:h_, w:w_].to(self._device)
+            scale = [value.to(dtype=z.dtype, device=z.device) for value in vae.scale]
+            z = z / scale[1].view(1, model.z_dim, 1, 1, 1) + scale[0].view(
+                1, model.z_dim, 1, 1, 1
+            )
+            x = model.conv2(z)
+            cache = self._caches[index]
+            parts = []
+            for step in range(T):
+                part, cache, _ = model.decoder(
+                    x[:, :, step : step + 1, :, :],
+                    feat_cache=cache,
+                    feat_idx=[0],
+                    first_chunk=first and step == 0,
+                )
+                parts.append(part)
+            self._caches[index] = cache
+            video = unpatchify(torch.cat(parts, 2), patch_size=2)
+            if not self._tiled:
+                values = video.clamp_(-1, 1)
+                break
+            video = video.to("cpu")
+            mask = vae.build_mask(
+                video,
+                is_bound=(h == 0, h_ >= H, w == 0, w_ >= W),
+                border_width=(
+                    (self._tile_size[0] - self._tile_stride[0]) * factor,
+                    (self._tile_size[1] - self._tile_stride[1]) * factor,
+                ),
+            ).to(dtype=hidden.dtype, device="cpu")
+            target_h, target_w = h * factor, w * factor
+            values[
+                :, :, :, target_h : target_h + video.shape[3], target_w : target_w + video.shape[4]
+            ] += video * mask
+            weight[
+                :, :, :, target_h : target_h + video.shape[3], target_w : target_w + video.shape[4]
+            ] += mask
+        if self._tiled:
+            values = values / weight
+            values = values.clamp_(-1, 1)
+        self._pipe.load_models_to_device([])
+        decoded = values[0].float().permute(1, 2, 3, 0)
+        frames = ((decoded + 1.0) * 127.5).clamp(0, 255).to("cpu").numpy().astype(np.uint8)
+        return frames[1:] if first else frames
+
