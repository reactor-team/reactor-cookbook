+def _interactive_camera_pad(camera, frame_count):
+    """Pad a camera tensor by holding its terminal pose."""
+    frame_count = int(frame_count)
+    if int(camera.shape[0]) >= frame_count:
+        return camera[:frame_count]
+    if int(camera.shape[0]) <= 0:
+        raise RuntimeError("interactive camera input is empty")
+    tail = camera[-1:].repeat(frame_count - int(camera.shape[0]), 1, 1)
+    return torch.cat([camera, tail], dim=0)
+
+
+def _interactive_camera_info_update(camera_info, chunk_camera_info, frame_indices):
+    """Update selected PRoPE camera slots without rebuilding the full timeline."""
+    frame_indices = [int(value) for value in frame_indices]
+    if not frame_indices:
+        return
+    if camera_info is None or chunk_camera_info is None:
+        raise RuntimeError("interactive rollout requires PRoPE camera metadata")
+    target_w2c, target_views = camera_info[:2]
+    source_w2c, source_views = chunk_camera_info[:2]
+    if len(frame_indices) != int(source_w2c.shape[1]):
+        raise RuntimeError(
+            "interactive PRoPE camera length mismatch: "
+            f"indices={len(frame_indices)} source={int(source_w2c.shape[1])}."
+        )
+    index = torch.as_tensor(frame_indices, device=target_w2c.device, dtype=torch.long)
+    target_w2c.index_copy_(1, index, source_w2c)
+    for target, source in zip(target_views, source_views):
+        target.index_copy_(1, index, source)
+
