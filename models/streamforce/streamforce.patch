index 0000000..7863d5a
--- /dev/null
+++ b/pipeline/force_conditions.py
@@ -0,0 +1,98 @@
+"""Force conditions for one block, built from the force that is current when the block starts.
+
+The offline scripts build the conditioning signal for a whole clip through the sample datasets
+(`utils/forceprompt_data/controlnet_datasets.py`) and slice it per window. A stream only knows the
+current force, so this module builds the same signal for ONE frame and repeats it over a block
+(the signal is constant in time while the force is), with the datasets' own functions and steps:
+
+  * wind: drawn straight at the target size (ForcePromptingDataset_WindForce*),
+    mask channel = ones;
+  * point: blob mask + force channels drawn on the 480x720 training canvas, then
+    `resize_for_crop` + `center_crop` to the target (ForcePromptingDataset_PointForce*);
+  * then the inference scripts' `prepare_hint`: threshold the frame-0 blob, mask the force
+    channels with it, and mask the first frame with it (`masked_latent`).
+
+Units are the datasets': strength 0..1, angle in degrees counter-clockwise from +x.
+Point positions: the datasets take (x_pos, y_pos) on the canvas with y measured UP from the
+bottom; a client gives (x, y) over the OUTPUT frame, origin top-left, which is where the blob
+lands after the canvas is resized and cropped. `frame_to_canvas` / `canvas_to_frame` convert.
+"""
+from typing import Tuple
+
+import numpy as np
+import torch
+import torchvision.transforms as transforms
+
+from utils.forceprompt_data.controlnet_datasets import (
+    _BLOB_CANVAS_H, _BLOB_CANVAS_W, load_controlnet_signal_wind_force, load_point_force_mask,
+    resize_for_crop,
+)
+from utils.misc import compress_time
+
+
+def fit_image(rgb: np.ndarray, height: int, width: int) -> torch.Tensor:
+    """uint8 HxWx3 -> uint8 [1, 3, height, width], as the datasets fit a still (resize to cover, centre crop)."""
+    x = torch.from_numpy(np.ascontiguousarray(rgb)).permute(2, 0, 1).contiguous().unsqueeze(0)
+    x = resize_for_crop(x, height, width)
+    return transforms.functional.center_crop(x, (height, width))
+
+
+def _canvas_geometry(height: int, width: int):
+    # resize_for_crop of the canvas to cover (height, width), then centre crop
+    coef = max(height / _BLOB_CANVAS_H, width / _BLOB_CANVAS_W)
+    out_h, out_w = max(int(_BLOB_CANVAS_H * coef), height), max(int(_BLOB_CANVAS_W * coef), width)
+    top = int(round((out_h - height) / 2.0))
+    left = int(round((out_w - width) / 2.0))
+    return out_h / _BLOB_CANVAS_H, out_w / _BLOB_CANVAS_W, top, left
+
+
+def canvas_to_frame(x_pos: float, y_pos: float, height: int, width: int) -> Tuple[float, float]:
+    """Dataset (x_pos, y_pos up from bottom) -> where the blob centre lands, (x, y) in 0..1 over the output, top-left origin."""
+    sy, sx, top, left = _canvas_geometry(height, width)
+    cx, cy = x_pos * _BLOB_CANVAS_W, (1 - y_pos) * _BLOB_CANVAS_H
+    return ((cx + 0.5) * sx - 0.5 - left) / width, ((cy + 0.5) * sy - 0.5 - top) / height
+
+
+def frame_to_canvas(x: float, y: float, height: int, width: int) -> Tuple[float, float]:
+    """Inverse of canvas_to_frame."""
+    sy, sx, top, left = _canvas_geometry(height, width)
+    cx = (x * width + left + 0.5) / sx - 0.5
+    cy = (y * height + top + 0.5) / sy - 0.5
+    return cx / _BLOB_CANVAS_W, 1 - cy / _BLOB_CANVAS_H
+
+
+def frame_signal(mode: str, strength: float, angle: float, x_pos: float, y_pos: float,
+                 height: int, width: int) -> torch.Tensor:
+    """The 4-channel signal [1, 4, height, width] (mask, magnitude, cos, sin) for one frame, float32 CPU."""
+    if mode == "wind":
+        sig = load_controlnet_signal_wind_force(strength, angle, num_frames=1, height=height, width=width,
+                                                min_force=0.0, max_force=1.0)
+        return torch.cat([torch.ones_like(sig[:, :1]), sig], dim=1)
+    if mode == "point":
+        sig = torch.cat([load_point_force_mask(x_pos, y_pos, num_frames=1),
+                         load_controlnet_signal_wind_force(strength, angle, num_frames=1,
+                                                           min_force=0.0, max_force=1.0)], dim=1)
+        sig = resize_for_crop(sig, height, width)
+        return transforms.functional.center_crop(sig, (height, width))
+    raise ValueError(f"unknown force mode {mode!r}")
+
+
+def block_conditions(signal: torch.Tensor, image: torch.Tensor, device, block: int = 3):
+    """(hint [1, block, 3, H, W] bf16, masked_latent [1, 1, 3, H, W] bf16) from a frame signal and the fitted first frame (uint8 [1, 3, H, W])."""
+    hint = signal.unsqueeze(0).float().to(device=device, dtype=torch.bfloat16)     # [B, T=1, 4, H, W]
+    img = image.float().unsqueeze(1)                                                # [B, T=1, 3, H, W]
+    # --- prepare_hint of inference_causal_rolling_forcing.py, verbatim ---
+    img = img.to(device=hint.device)
+    img = img.permute(0, 2, 1, 3, 4)
+    img = img / 255.0
+    img = img * 2.0 - 1.0
+    gaussian_blob = hint[:, 0:1, 0:1]
+    hint = hint[:, :, 1:] * (gaussian_blob > 1e-1)
+    masked_image = (img + 1.0) / 2.0 * gaussian_blob.permute(0, 2, 1, 3, 4)
+    masked_image = masked_image * 2.0 - 1.0
+    masked_image = masked_image.permute(0, 2, 1, 3, 4)
+    masked_latent = compress_time(masked_image, 81, method="subsample")
+    # ---
+    hint = hint.to(device=device, dtype=torch.bfloat16)
+    masked_latent = masked_latent.to(device=device, dtype=torch.bfloat16)
+    return hint.expand(-1, block, -1, -1, -1).contiguous(), masked_latent
