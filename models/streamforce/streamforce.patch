new file mode 100644
index 0000000..d41d754
--- /dev/null
+++ b/pipeline/rolling_forcing_step.py
@@ -0,0 +1,274 @@
+"""Rolling forcing, one window per call.
+
+`ControlRollingForcingInferencePipeline.inference_rolling_forcing` plans a whole clip: it sizes
+`output` and `noisy_cache` to the clip and loops over every window. This module is the same loop
+body, called once per window, holding only bounded state between calls:
+
+  * the noisy latents of the (at most 3) blocks still being denoised,
+  * the per-block conditions (force hint) of the blocks in the window,
+  * the KV / cross-attention caches the pipeline already owns (fixed size, rolling),
+  * the first frame's latent (the anchor) and the text conditioning.
+
+Window w denoises blocks max(0, w-3) .. w at the four noise levels of `denoising_step_list`;
+block w enters as fresh noise and block w-3 leaves clean, so from w = 3 on every call returns one
+clean block (3 latent frames). With `total_blocks` set (a finite clip) the last windows shrink
+the way the source's do (no new block enters); without it the stream is endless up to the
+position limit of the RoPE table (`max_blocks`).
+
+Every tensor operation below is the source loop's, in the source's order, so a clip generated
+through this class is bit-identical to `inference_rolling_forcing` on the same inputs.
+"""
+from typing import Dict, List, Optional
+
+import torch
+
+
+class PositionLimitReached(Exception):
+    """The next window would place latents past the temporal RoPE table."""
+
+
+class RollingForcingStream:
+    def __init__(self, pipe):
+        self.pipe = pipe
+        self.block = pipe.num_frame_per_block
+        self.window_blocks = len(pipe.denoising_step_list)  # rolling window = denoising steps
+        # The causal model indexes its temporal RoPE table by absolute latent frame; past its
+        # length the slice comes back short and the forward fails. The table is the hard limit.
+        freqs = pipe.generator.model.freqs
+        self.rope_frames = int(freqs.shape[0])
+        self.max_blocks = self.rope_frames // self.block
+        self.started = False
+
+    # ---------------------------------------------------------------- session ---
+    def begin(self, initial_latent: torch.Tensor, conditional_dict: Dict[str, torch.Tensor]):
+        """Start a stream from the first frame's latent [B, 1, C, h, w] and the text conditioning."""
+        pipe = self.pipe
+        self.initial_latent = initial_latent
+        self.conditional_dict = conditional_dict
+        batch_size, _, num_channels, height, width = initial_latent.shape
+        self.shape = (batch_size, num_channels, height, width)
+        self.device, self.dtype = initial_latent.device, torch.bfloat16
+
+        if pipe.kv_cache1 is None:
+            pipe._initialize_kv_cache(batch_size=batch_size, dtype=self.dtype, device=self.device)
+            pipe._initialize_crossattn_cache(batch_size=batch_size, dtype=self.dtype, device=self.device)
+            pipe._initialize_kv_cache2(batch_size=batch_size, dtype=self.dtype, device=self.device)
+            pipe._initialize_crossattn_cache2(batch_size=batch_size, dtype=self.dtype, device=self.device)
+        else:
+            for block_index in range(pipe.num_transformer_blocks):
+                pipe.crossattn_cache[block_index]["is_init"] = False
+                pipe.crossattn_cache2[block_index]["is_init"] = False
+            for block_index in range(len(pipe.kv_cache1)):
+                pipe.kv_cache1[block_index]["global_end_index"] = torch.tensor([0], dtype=torch.long, device=self.device)
+                pipe.kv_cache1[block_index]["local_end_index"] = torch.tensor([0], dtype=torch.long, device=self.device)
+                pipe.kv_cache2[block_index]["global_end_index"] = torch.tensor([0], dtype=torch.long, device=self.device)
+                pipe.kv_cache2[block_index]["local_end_index"] = torch.tensor([0], dtype=torch.long, device=self.device)
+
+        if pipe.initial_latent_to_cahce:
+            raise NotImplementedError("initial_latent_to_cahce is off in every shipped config")
+
+        self.shared_timestep = torch.ones(
+            [batch_size, self.window_blocks * self.block], device=self.device, dtype=torch.float32
+        )
+        for index, current_timestep in enumerate(reversed(pipe.denoising_step_list)):
+            self.shared_timestep[:, index * self.block:(index + 1) * self.block] *= current_timestep
+
+        self.window_index = 0
+        self.noisy: Dict[int, torch.Tensor] = {}   # block -> noisy latents for its next step
+        self.hints: Dict[int, torch.Tensor] = {}   # block -> hint [B, 3, c, H, W]
+        self.started = True
+
+    def set_text(self, conditional_dict: Dict[str, torch.Tensor]):
+        """New text conditioning from the next window on; the cross-attention caches re-project it."""
+        pipe = self.pipe
+        self.conditional_dict = conditional_dict
+        for block_index in range(pipe.num_transformer_blocks):
+            pipe.crossattn_cache[block_index]["is_init"] = False
+            pipe.crossattn_cache2[block_index]["is_init"] = False
+
+    def next_window_blocks(self, total_blocks: Optional[int] = None):
+        w = self.window_index
+        start_block = max(0, w - self.window_blocks + 1)
+        end_block = w if total_blocks is None else min(total_blocks - 1, w)
+        return start_block, end_block
+
+    # ----------------------------------------------------------------- window ---
+    def window(self, new_block_hint: Optional[torch.Tensor], masked_latent: Optional[torch.Tensor],
+               total_blocks: Optional[int] = None):
+        """Run one rolling window.
+
+        new_block_hint: the hint for the block entering the window [B, 3, c, H, W] (ignored when
+        no block enters, i.e. in a finite clip's closing windows). Returns (block_index, latents
+        [B, 3, C, h, w]) for the block that left the window clean, or None.
+        """
+        pipe = self.pipe
+        block = self.block
+        batch_size, num_channels, height, width = self.shape
+        start_block, end_block = self.next_window_blocks(total_blocks)
+        if end_block >= self.max_blocks:
+            raise PositionLimitReached(
+                f"the temporal RoPE table has {self.rope_frames} latent slots; block {end_block} "
+                f"would need latents up to {(end_block + 1) * block - 1}")
+
+        current_start_frame = start_block * block
+        current_end_frame = (end_block + 1) * block
+        current_num_frames = current_end_frame - current_start_frame
+        full = self.window_blocks * block
+        entering = total_blocks is None or self.window_index < total_blocks
+
+        if current_num_frames == full or current_start_frame == 0:
+            parts = [self.noisy[b] for b in range(start_block, end_block)]
+            parts.append(torch.randn([batch_size, block, num_channels, height, width],
+                                     device=self.device, dtype=self.dtype))
+            noisy_input = torch.cat(parts, dim=1)
+        else:
+            noisy_input = torch.cat([self.noisy[b] for b in range(start_block, end_block + 1)], dim=1)
+
+        if current_num_frames == full:
+            current_timestep = self.shared_timestep.clone()
+        elif current_start_frame == 0:
+            current_timestep = self.shared_timestep[:, -current_num_frames:].clone()
+        elif total_blocks is not None and current_end_frame == total_blocks * block:
+            current_timestep = self.shared_timestep[:, :current_num_frames].clone()
+        else:
+            raise ValueError("current_num_frames should be full window, first window, or last window")
+
+        if current_start_frame == 0:
+            noisy_input[:, :1] = self.initial_latent[:, :1]
+            current_timestep[:, :1] = 0
+
+        if entering and new_block_hint is not None:
+            self.hints[end_block] = new_block_hint
+        hint_input = None
+        if self.hints:
+            hint_input = torch.cat([self.hints[b] for b in range(start_block, end_block + 1)], dim=1)
+
+        _, denoised_pred = pipe.generator(
+            noisy_image_or_video=noisy_input,
+            conditional_dict=self.conditional_dict,
+            timestep=current_timestep,
+            kv_cache=pipe.kv_cache1,
+            crossattn_cache=pipe.crossattn_cache,
+            kv_cache2=pipe.kv_cache2,
+            crossattn_cache2=pipe.crossattn_cache2,
+            current_start=current_start_frame * pipe.frame_seq_length,
+            hint=hint_input,
+            masked_latent=masked_latent,
+        )
+
+        clean = None
+        with torch.no_grad():
+            for block_idx in range(start_block, end_block + 1):
+                local_start = (block_idx - start_block) * block
+                local_end = local_start + block
+                block_timestep_values = current_timestep[:, local_start:local_end].reshape(-1).float()
+                non_zero_values = block_timestep_values[block_timestep_values > 0]
+                if non_zero_values.numel() > 0:
+                    block_timestep = non_zero_values.float().mean().item()
+                else:
+                    block_timestep = block_timestep_values.float().mean().item()
+                matches = torch.abs(pipe.denoising_step_list.float() - block_timestep) < 1e-4
+                matched_indices = torch.nonzero(matches, as_tuple=True)[0]
+                if matched_indices.numel() == 0:
+                    nearest_idx = torch.argmin(torch.abs(pipe.denoising_step_list.float() - block_timestep)).item()
+                    nearest_step = pipe.denoising_step_list[nearest_idx].item()
+                    if abs(float(nearest_step) - float(block_timestep)) < 1e-2:
+                        matched_indices = torch.tensor([nearest_idx], device=self.device)
+                    else:
+                        raise RuntimeError(f"Cannot map block timestep {block_timestep} to denoising_step_list")
+                block_timestep_index = int(matched_indices[0].item())
+                if block_timestep_index == len(pipe.denoising_step_list) - 1:
+                    # this block leaves the window clean
+                    clean = (block_idx, denoised_pred[:, local_start:local_end])
+                    self.noisy.pop(block_idx, None)
+                    continue
+                next_timestep = pipe.denoising_step_list[block_timestep_index + 1].to(self.device)
+                updated_noisy = pipe.scheduler.add_noise(
+                    denoised_pred.flatten(0, 1),
+                    torch.randn_like(denoised_pred.flatten(0, 1)),
+                    next_timestep * torch.ones([batch_size * current_num_frames], device=self.device, dtype=torch.long),
+                ).unflatten(0, denoised_pred.shape[:2])
+                self.noisy[block_idx] = updated_noisy[:, local_start:local_end]
+
+        with torch.no_grad():
+            context_denoised_pred = denoised_pred[:, :block].clone()
+            context_timestep = torch.ones_like(current_timestep[:, :block]) * pipe.args.context_noise
+            if current_start_frame == 0:
+                context_denoised_pred[:, :1] = self.initial_latent[:, :1]
+            context_hint = None
+            if hint_input is not None:
+                context_hint = hint_input[:, :block]
+            pipe.generator(
+                noisy_image_or_video=context_denoised_pred,
+                conditional_dict=self.conditional_dict,
+                timestep=context_timestep,
+                kv_cache=pipe.kv_cache1,
+                crossattn_cache=pipe.crossattn_cache,
+                kv_cache2=pipe.kv_cache2,
+                crossattn_cache2=pipe.crossattn_cache2,
+                current_start=current_start_frame * pipe.frame_seq_length,
+                hint=context_hint,
+                masked_latent=masked_latent,
+                updating_cache=True,
+            )
+
+        self.window_index += 1
+        # keep only what the next window reads: bounded to the window's blocks
+        next_start = max(0, self.window_index - self.window_blocks + 1)
+        for b in [b for b in self.hints if b < next_start]:
+            self.hints.pop(b)
+        return clean
+
+
+class BlockDecoder:
+    """Wan2.2 VAE decode, one clean block at a time.
+
+    `WanVAE_.decode` already walks the latent frames one by one with a causal feature cache; this
+    is that loop, kept alive across calls instead of clearing the cache per clip. The arithmetic
+    (scale with `1.0 / std.to(dtype)`, conv2, the per-frame decoder, unpatchify, clamp) is the
+    same as `WanVAEWrapper.decode_to_pixel(..., use_cache=False)`.
+    """
+
+    def __init__(self, vae_wrapper):
+        self.vae = vae_wrapper
+        self.model = vae_wrapper.model
+        self.reset()
+
+    def reset(self):
+        self.model.clear_cache()
+        self.first = True
+
+    def decode(self, latents: torch.Tensor) -> torch.Tensor:
+        """latents [1, t, C, h, w] -> frames [1, T, 3, H, W] in [0, 1] (T = 1 + 4(t-1) on the first call, 4t after)."""
+        from wan.modules.vae2_2 import unpatchify
+        if latents.shape[0] != 1:
+            raise ValueError("BlockDecoder decodes batch size 1")
+        model = self.model
+        z = latents.permute(0, 2, 1, 3, 4)
+        device, dtype = z.device, z.dtype
+        mean = self.vae.mean.to(device=device, dtype=dtype)
+        inv = 1.0 / self.vae.std.to(device=device, dtype=dtype)
+        z = z / inv.view(1, model.z_dim, 1, 1, 1) + mean.view(1, model.z_dim, 1, 1, 1)
+        x = model.conv2(z)
+        outs = []
+        for i in range(x.shape[2]):
+            model._conv_idx = [0]
+            if self.first:
+                outs.append(model.decoder(x[:, :, i:i + 1], feat_cache=model._feat_map,
+                                          feat_idx=model._conv_idx, first_chunk=True))
+                self.first = False
+            else:
+                outs.append(model.decoder(x[:, :, i:i + 1], feat_cache=model._feat_map,
+                                          feat_idx=model._conv_idx))
+        out = unpatchify(torch.cat(outs, 2), patch_size=2).float().clamp_(-1, 1)
+        video = out.permute(0, 2, 1, 3, 4)
+        return (video * 0.5 + 0.5).clamp(0, 1)
+
+
+def encode_first_frame(pipe, image: torch.Tensor) -> torch.Tensor:
+    """First frame [B, 1, 3, H, W] (0..255) -> its latent [B, 1, C, h, w] bf16, as inference_rolling_forcing does."""
+    image = image.to(pipe.generator.model.device, dtype=torch.bfloat16)
+    image = image.permute(0, 2, 1, 3, 4)
+    image = image / 255.0
+    image = image * 2.0 - 1.0
+    return pipe.vae.encode_to_latent(image).to(device=pipe.generator.model.device, dtype=torch.bfloat16)
