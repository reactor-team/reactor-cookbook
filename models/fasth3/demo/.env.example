# Local Reactor model. This mode is selected when REACTOR_API_KEY is unset.
# REACTOR_LOCAL_URL=http://localhost:8080

# Hosted Reactor model. The key remains on the Next.js server and is exchanged
# for a short-lived, model-scoped browser token.
# REACTOR_API_KEY=replace_with_your_reactor_api_key
# REACTOR_MODEL_NAME=your-org/fasth3
# REACTOR_API_URL=https://api.reactor.inc
