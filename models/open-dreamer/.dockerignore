# Files excluded from the image build context (`COPY . /app/`).

# Python build / cache artefacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Python venvs — the image installs its own dependencies.
.venv/
venv/

# Editor / IDE state
.vscode/
.idea/
*.swp

# OS metadata
.DS_Store
Thumbs.db

# Source control
.git/
.gitignore

# Docker config — already consumed by `docker build`, no need to ship.
Dockerfile
.dockerignore
